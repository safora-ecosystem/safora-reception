# core-api base URL (safora-backend/apps/core-api). Local dev default below.
VITE_API_URL=http://localhost:3000

# Cloudflare Turnstile sitekey — OCHIQ qiymat (secret backendda). Lokalda bo'sh qoldiring:
# widget render qilinmaydi va backend ham TURNSTILE_ENABLED=false bilan tokensiz ishlaydi.
VITE_TURNSTILE_SITEKEY=

# Firebase web push (FCM) — "Brauzer bildirishnomasi" tab YOPIQ bo'lganda ham kelishi uchun.
# Qiymatlar: Firebase Console → Project settings → General → Your apps → Web app (config).
# VAPID kalit: Project settings → Cloud Messaging → Web Push certificates → Key pair.
# Bo'sh qoldirilsa toggle eski rejimda ishlaydi (faqat tab ochiq bo'lganda).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
